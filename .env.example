# Product Hunt official API
PRODUCT_HUNT_TOKEN=
PRODUCT_HUNT_COMMERCIAL_AUTHORIZED=false

# Notion READY destination is intentionally allowlisted in the upstream package.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=4109e605-ccf8-81c4-accd-c19386b4a38d
NOTION_ENABLE_SYNC=true
NOTION_AUTOSYNC_AFTER_GENERATION=true

# Persistent application data. Keep all of it under /data/opt on InstaBox.
PRODUCTHUNT_SOURCE=producthunt
PRODUCTHUNT_DB_PATH=/data/opt/sandbox-producthunt/data/producthunt.sqlite
PRODUCTHUNT_OUTPUT_DIR=/data/opt/sandbox-producthunt/output
PRODUCTHUNT_OPPORTUNITY_THRESHOLD=60
PRODUCTHUNT_MAX_RESEARCH=5

# DSH Headless. Model/provider selection is managed by DSH, not OmniRoute.
DSH_BIN=dsh
DSH_PROFILE=headless
DSH_PERMISSION_MODE=read-only
DSH_APPROVAL_POLICY=never
DSH_TIMEOUT_SECONDS=600
# Optional DSH profile patch file, if a dedicated headless model selection is needed.
# DSH_PATCH_FILE=/data/opt/sandbox-producthunt/config/headless-model.patch.yml

# If your DSH profile uses a provider apiKeyEnv reference, define that exact
# environment variable here. Headless uses launch env / this directory's .env /
# $DSH_HOME/.env; it does not automatically consume credentials saved by Web UI.
# Example only (replace with the apiKeyEnv name configured in your DSH provider):
# MY_DSH_PROVIDER_API_KEY=

# Optional control run using the original OpenAI Agents SDK instead of DSH.
SANDBOX_RUNTIME=dsh
# OMNIROUTE_BASE_URL=
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=minimax-cn/MiniMax-M3
